# ConnectNest frontend environment.
# Copy to `.env` and fill in from the CDK stack outputs:
#   cd infra && npx cdk deploy --all
# Outputs: ConnectNest-Auth.UserPoolId, ConnectNest-Auth.UserPoolClientId,
#          ConnectNest-Api.ApiUrl

REACT_APP_AWS_REGION=us-east-1
REACT_APP_USER_POOL_ID=us-east-1_xxxxxxxxx
REACT_APP_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
REACT_APP_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# WebSocket API URL for live updates — from the ConnectNest-Realtime.WebSocketUrl
# stack output. The socket cannot be proxied through CloudFront /api/*, so leave
# this blank to disable live updates (the feeds still work via polling/refresh).
REACT_APP_WS_URL=wss://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# Social login (Google / Microsoft) via Cognito Hosted UI — optional.
# From the ConnectNest-Auth.HostedUiDomain output. Leave blank to hide the
# social buttons (email/password still works).
REACT_APP_HOSTED_UI_DOMAIN=connectnest-auth.auth.us-east-1.amazoncognito.com
# Optional override; defaults to <origin>/auth/callback
# REACT_APP_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
